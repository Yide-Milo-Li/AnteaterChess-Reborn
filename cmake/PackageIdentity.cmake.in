file(WRITE "${CPACK_TEMPORARY_DIRECTORY}/SOURCE_REVISION" "@AC_SOURCE_COMMIT@\n")
file(GLOB_RECURSE ac_files LIST_DIRECTORIES FALSE "${CPACK_TEMPORARY_DIRECTORY}/*")
list(SORT ac_files)
set(ac_checksums "")
foreach(ac_file IN LISTS ac_files)
    file(RELATIVE_PATH ac_name "${CPACK_TEMPORARY_DIRECTORY}" "${ac_file}")
    if(NOT ac_name STREQUAL "FILES.sha256")
        file(SHA256 "${ac_file}" ac_sha)
        string(APPEND ac_checksums "${ac_sha}  ${ac_name}\n")
    endif()
endforeach()
file(WRITE "${CPACK_TEMPORARY_DIRECTORY}/FILES.sha256" "${ac_checksums}")
